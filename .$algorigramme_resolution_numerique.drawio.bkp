<mxfile host="Electron" agent="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) draw.io/24.7.17 Chrome/128.0.6613.36 Electron/32.0.1 Safari/537.36" version="24.7.17">
  <diagram id="algo-resolution-pendule" name="Algorithmes">
    <mxGraphModel dx="1152" dy="782" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Algorigramme - resolution numerique du pendule" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=20;fontStyle=1;fontColor=#363535;" parent="1" vertex="1">
          <mxGeometry x="260" y="20" width="520" height="40" as="geometry" />
        </mxCell>
        <mxCell id="start" value="Debut" style="ellipse;whiteSpace=wrap;html=1;fontSize=14;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#363535;" parent="1" vertex="1">
          <mxGeometry x="440" y="80" width="120" height="50" as="geometry" />
        </mxCell>
        <mxCell id="params" value="Definir les parametres&lt;br&gt;L, m, g, t, dt, theta(0), omega(0)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#363535;" parent="1" vertex="1">
          <mxGeometry x="375" y="160" width="250" height="65" as="geometry" />
        </mxCell>
        <mxCell id="choose" value="Calculer les 3 solutions&lt;br&gt;pour le meme theta(0)" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;spacing=6;spacingTop=-4;fontColor=#363535;" parent="1" vertex="1">
          <mxGeometry x="420" y="255" width="160" height="100" as="geometry" />
        </mxCell>
        <mxCell id="lin_title" value="Petits angles&lt;br&gt;solution theorique" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fontStyle=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#363535;" parent="1" vertex="1">
          <mxGeometry x="80" y="410" width="190" height="50" as="geometry" />
        </mxCell>
        <mxCell id="lin_calc" value="Utiliser sin(theta) ~= theta&lt;br&gt;theta(t) = theta0 cos(w0 t)&lt;br&gt;omega(t) = -theta0 w0 sin(w0 t)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#E8D8C3;strokeColor=#b85450;fontColor=#363535;" parent="1" vertex="1">
          <mxGeometry x="60" y="490" width="230" height="85" as="geometry" />
        </mxCell>
        <mxCell id="euler_title" value="Euler explicite&lt;br&gt;sans approximation" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fontStyle=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#363535;" parent="1" vertex="1">
          <mxGeometry x="405" y="390" width="190" height="50" as="geometry" />
        </mxCell>
        <mxCell id="euler_init" value="Initialiser les tableaux&lt;br&gt;theta[0] = theta0&lt;br&gt;omega[0] = omega0" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#E8D8C3;strokeColor=#d79b00;fontColor=#363535;" parent="1" vertex="1">
          <mxGeometry x="385" y="470" width="230" height="75" as="geometry" />
        </mxCell>
        <mxCell id="euler_loop" value="Pour i de 0 a N-1" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d79b00;spacing=6;spacingTop=-4;fontColor=#363535;" parent="1" vertex="1">
          <mxGeometry x="430" y="575" width="140" height="80" as="geometry" />
        </mxCell>
        <mxCell id="euler_step" value="theta[i+1] = theta[i] + dt omega[i]&lt;br&gt;omega[i+1] = omega[i] - dt (g/L) sin(theta[i])" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#E8D8C3;strokeColor=#d79b00;fontColor=#363535;" parent="1" vertex="1">
          <mxGeometry x="345" y="705" width="310" height="65" as="geometry" />
        </mxCell>
        <mxCell id="rk4_title" value="Runge-Kutta 4&lt;br&gt;sans approximation" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#363535;" parent="1" vertex="1">
          <mxGeometry x="765" y="407.5" width="190" height="50" as="geometry" />
        </mxCell>
        <mxCell id="rk4_init" value="Initialiser l&#39;etat&lt;br&gt;y = [theta, omega]" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#E8D8C3;strokeColor=#6c8ebf;fontColor=#363535;" parent="1" vertex="1">
          <mxGeometry x="745" y="487.5" width="230" height="65" as="geometry" />
        </mxCell>
        <mxCell id="rk4_loop" value="Pour i de 0 a N-1" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;spacing=6;spacingTop=-4;fontColor=#363535;" parent="1" vertex="1">
          <mxGeometry x="790" y="582.5" width="140" height="80" as="geometry" />
        </mxCell>
        <mxCell id="rk4_step" value="Calculer les pentes&lt;br&gt;k1 = f(y)&lt;br&gt;k2 = f(y + dt k1 / 2)&lt;br&gt;k3 = f(y + dt k2 / 2)&lt;br&gt;k4 = f(y + dt k3)&lt;br&gt;y[i+1] = y[i] + dt(k1+2k2+2k3+k4)/6" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#E8D8C3;strokeColor=#6c8ebf;fontColor=#363535;" parent="1" vertex="1">
          <mxGeometry x="730" y="702.5" width="320" height="120" as="geometry" />
        </mxCell>
        <mxCell id="energies" value="Calculer les energies&lt;br&gt;Ec = 1/2 m (L omega)^2&lt;br&gt;Ep petits angles = 1/2 m g L theta^2&lt;br&gt;Ep non lineaire = m g L (1 - cos(theta))" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#363535;" parent="1" vertex="1">
          <mxGeometry x="300" y="880" width="390" height="90" as="geometry" />
        </mxCell>
        <mxCell id="display" value="Construire la figure&lt;br&gt;1 zone pendule&lt;br&gt;2 zones energie" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#363535;" parent="1" vertex="1">
          <mxGeometry x="90" y="1010" width="230" height="70" as="geometry" />
